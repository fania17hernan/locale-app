# Netlify / GitHub Pages (via Pages-hosted _headers) Content Security Policy
# This file is served by GitHub Pages if the repo uses the pages-headers feature.
# Note: Standard GitHub Pages does not support custom headers natively.
# For full CSP support, proxy via Cloudflare Pages or Netlify instead.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net 'unsafe-inline' 'unsafe-eval'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://api.anthropic.com https://*.supabase.co wss://*.supabase.co https://api.open-meteo.com https://geocoding-api.open-meteo.com; img-src 'self' data: blob:; worker-src 'self' blob:; manifest-src 'self'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
